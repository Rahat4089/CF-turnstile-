{
  "manifest_version": 3,
  "name": "Turnstile Inspector",
  "description": "Capture Cloudflare Turnstile sitekey, action, and cdata while solving manually.",
  "version": "1.0.0",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Turnstile Inspector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
